# Copy this file to .env.local and fill in real values.
# Only variables prefixed NEXT_PUBLIC_ are sent to the browser. Everything
# else stays on the server; never prefix a secret with NEXT_PUBLIC_.

# --- Business ----------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (Project Settings > API Keys) ----------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# The publishable key (sb_publishable_...) or the legacy "anon" key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# The secret key (sb_secret_...) or the legacy "service_role" key. Server only:
# bypasses Row Level Security.
SUPABASE_SECRET_KEY=

# --- Google: Gemini driveway estimator + Static Maps snapshot ----------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Needs Geocoding API + Maps Static API enabled
GOOGLE_MAPS_API_KEY=

# --- OpenWeatherMap: storm trigger -------------------------------------------
OPENWEATHER_API_KEY=
# Forecast snow (mm of precipitation, roughly = cm on the ground) between now
# and the end of tomorrow that starts a storm day
SNOW_ALERT_THRESHOLD_MM=5
# Service-area centre, used for the forecast check (Toronto shown)
SERVICE_AREA_LAT=43.6532
SERVICE_AREA_LON=-79.3832
SERVICE_TIMEZONE=America/Toronto

# --- Twilio: storm texts to customers and staff -------------------------------
# Staff alert numbers live in the `staff` table. Point the Twilio number's
# incoming-message webhook at <NEXT_PUBLIC_SITE_URL>/api/twilio/sms
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Shared secret the daily storm check sends as a Bearer token. Use a long
# random string, e.g. `openssl rand -hex 32`
CRON_SECRET=
