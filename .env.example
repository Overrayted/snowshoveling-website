# Copy this file to .env.local (for `npm run dev`) and to .dev.vars (for
# `npm run preview`), then fill in real values. For the live site, add each
# one in Cloudflare (Workers > kaiyns > Settings > Variables and Secrets).
# All of these stay on the server; none are sent to browsers.

# --- Site ----------------------------------------------------------------------
# Public address of the site, no trailing slash. Texts link to it and the
# Twilio security check depends on it being exact.
SITE_URL=http://localhost:3000

# --- PocketBase (your home server) -----------------------------------------------
# Public HTTPS address of PocketBase, e.g. https://api.kaiyns.com
POCKETBASE_URL=http://127.0.0.1:8090
# A superuser account the website signs in as. Create a dedicated one for the
# site (PocketBase dashboard > Superusers) rather than using your own.
POCKETBASE_SUPERUSER_EMAIL=
POCKETBASE_SUPERUSER_PASSWORD=
# Optional: if PocketBase is behind Cloudflare Access, a service token for it
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=

# --- Stripe (payments) -----------------------------------------------------------
# Developers > API keys. Use the sk_test_... key until you're ready for real money.
STRIPE_SECRET_KEY=
# Developers > Webhooks > your endpoint > Signing secret (whsec_...)
STRIPE_WEBHOOK_SECRET=
# Last day of the snow season (YYYY-MM-DD). Monthly plans stop renewing after
# it and Full Season plans end. Update it every year.
SEASON_END_DATE=2027-04-30

# --- Google: Gemini driveway estimator + Static Maps snapshot ----------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Needs Geocoding API + Maps Static API enabled
GOOGLE_MAPS_API_KEY=

# --- OpenWeatherMap: storm trigger -------------------------------------------
OPENWEATHER_API_KEY=
# Forecast snow (mm of precipitation, roughly = cm on the ground) between now
# and the end of tomorrow that starts a storm day
SNOW_ALERT_THRESHOLD_MM=5
# Service-area centre, used for the forecast check (Toronto shown)
SERVICE_AREA_LAT=43.6532
SERVICE_AREA_LON=-79.3832
SERVICE_TIMEZONE=America/Toronto

# --- Twilio: storm texts to customers and staff -------------------------------
# Staff alert numbers live in the `staff` table. Point the Twilio number's
# incoming-message webhook at <SITE_URL>/api/twilio/sms
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Shared secret the daily storm check sends as a Bearer token. Use a long
# random string, e.g. `openssl rand -hex 32`
CRON_SECRET=
